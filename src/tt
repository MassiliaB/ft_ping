#include <stdio.h>
#include <math.h>

void icmp_loop(int raw_sockfd, struct sockaddr_in *ping_addr, struct timespec *tfs, struct timespec *tfe, char *argv, char *ip_addr, int ttl_val, char *ping_domain) {
    struct timespec time_start;
    struct timespec time_end;
    long rtt_msec;
    int timeElapsed;
    int msg_count = 0;
    int msg_received_count = 0;

    // RTT statistics
    long min_rtt = __LONG_MAX__;
    long max_rtt = 0;
    long sum_rtt = 0;
    long sum_rtt_sq = 0; // Sum of squared RTTs for std deviation calculation

    signal(SIGINT, intHandler);
    
    while (pingloop) {
        if (!send_packet(++msg_count, raw_sockfd, ping_addr, &time_start))
            return;

        printf("rcv count = %d, msg count %d\n", msg_received_count, msg_count);
        
        while (msg_received_count < msg_count && pingloop) {
            if (recieve_packet(raw_sockfd, &ttl_val)) {
                clock_gettime(CLOCK_MONOTONIC, &time_end);
                
                // Calculate RTT
                rtt_msec = (time_end.tv_nsec - time_start.tv_nsec) / 1000000;
                rtt_msec += (time_end.tv_sec - time_start.tv_sec) * 1000;
                
                printf("%d bytes from %s (%s): icmp_seq=%d ttl=%d time=%ld ms\n", PING_PKT_S, ping_domain, ip_addr, msg_count, ttl_val, rtt_msec);
                
                // Update statistics
                if (rtt_msec < min_rtt) min_rtt = rtt_msec;
                if (rtt_msec > max_rtt) max_rtt = rtt_msec;
                
                sum_rtt += rtt_msec;
                sum_rtt_sq += rtt_msec * rtt_msec; // Sum of squares for standard deviation
                
                msg_received_count++;
            }
        }
    }

    clock_gettime(CLOCK_MONOTONIC, &(*tfe));
    timeElapsed = (tfe->tv_nsec - tfs->tv_nsec) / 1000000;
    timeElapsed += (tfe->tv_sec - tfs->tv_sec) * 1000;

    // Compute avg RTT
    double avg_rtt = (msg_received_count > 0) ? ((double)sum_rtt / msg_received_count) : 0;

    // Compute mdev RTT (standard deviation)
    double mdev_rtt = 0;
    if (msg_received_count > 0) {
        double variance = ((double)sum_rtt_sq / msg_received_count) - (avg_rtt * avg_rtt);
        mdev_rtt = sqrt(variance);
    }

    printf("--- %s ping statistics ---\n", argv);
    printf("%d packets transmitted, %d received, %.2f%% packet loss, time %dms\n", 
           msg_count, msg_received_count, 
           ((msg_count - msg_received_count) * 100.0) / msg_count, 
           timeElapsed);
    
    if (msg_received_count > 0) {
        printf("rtt min/avg/max/mdev = %.3f/%.3f/%.3f/%.3f ms\n",
               (double)min_rtt, avg_rtt, (double)max_rtt, mdev_rtt);
    }

    close(raw_sockfd);
}